# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HackaVerse Frontend — Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# INSTRUCTIONS:
#   1. Copy this file to .env:       cp .env.example .env
#   2. Fill in values below
#   3. DO NOT commit .env to version control
#   4. All Vite env vars MUST be prefixed with VITE_
#   5. See ENV_REFERENCE.md for full documentation
#
# STARTUP BEHAVIOR:
#   - If VITE_API_URL is not set → defaults to http://localhost:8000
#   - If VITE_API_KEY is not set → falls back to a hardcoded key (NOT SAFE for production)
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─────────────────────────────────────────────────
# API CONNECTION [REQUIRED]
# ─────────────────────────────────────────────────
# Primary backend API URL — this is the canonical connection variable
# Local development: http://localhost:8000
# Production:        https://ai-agent-x2iw.onrender.com
VITE_API_URL=http://localhost:8000

# Legacy alias — VITE_API_URL takes precedence if both are set
# IMPORTANT: Do NOT set both to different values
# VITE_API_BASE_URL=http://localhost:8000

# API key matching backend's API_KEY environment variable
# SECURITY: Must match backend API_KEY. Do NOT hardcode in source files.
VITE_API_KEY=

# ─────────────────────────────────────────────────
# APPLICATION METADATA
# ─────────────────────────────────────────────────
VITE_APP_NAME=HackaVerse
VITE_APP_VERSION=2.0.0

# ─────────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────────
VITE_NODE_ENV=development

# ─────────────────────────────────────────────────
# MOCK API (Development only)
# ─────────────────────────────────────────────────
# Enable mock API for frontend-only development without backend
VITE_USE_MOCK_API=false
VITE_MOCK_API_PORT=3002

# ─────────────────────────────────────────────────
# PWA CONFIGURATION
# ─────────────────────────────────────────────────
VITE_PWA_ENABLED=true
VITE_PWA_THEME_COLOR=#00FFFF
VITE_PWA_BACKGROUND_COLOR=#000000

# ─────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────
VITE_FEATURE_ANIMATIONS=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_NOTIFICATIONS=true