{
  "contract_type": "api_response",
  "version": "1.0",
  "description": "Canonical APIResponse envelope used by ALL HackaVerse API endpoints. Every response — success or failure — follows this exact schema. This is the foundational contract for TANTRA ecosystem participation.",
  "schema": {
    "success": {
      "type": "boolean",
      "description": "Whether the request was successful",
      "required": true
    },
    "message": {
      "type": "string",
      "description": "Human-readable status message",
      "required": true
    },
    "data": {
      "type": "object | array | null",
      "description": "Payload data. Null on error responses.",
      "required": true
    },
    "trace_id": {
      "type": "string",
      "pattern": "^hv-[a-f0-9]{16}$",
      "description": "Unique trace identifier generated by TraceIdMiddleware. Present in every response for correlation.",
      "required": true
    },
    "error_code": {
      "type": "string | null",
      "description": "Machine-readable error code from error_codes.py registry. Null on success.",
      "required": true,
      "enum_source": "src/observability/error_codes.py"
    }
  },
  "examples": {
    "success": {
      "success": true,
      "message": "Login successful",
      "data": {
        "access_token": "eyJ...",
        "refresh_token": "eyJ...",
        "token_type": "bearer",
        "user": {
          "user_id": "usr_001",
          "email": "user@hackaverse.com",
          "name": "Test User",
          "role": "participant"
        }
      },
      "trace_id": "hv-a1b2c3d4e5f67890",
      "error_code": null
    },
    "error": {
      "success": false,
      "message": "Invalid email or password",
      "data": null,
      "trace_id": "hv-f1e2d3c4b5a67890",
      "error_code": "AUTH_INVALID_TOKEN"
    },
    "validation_error": {
      "success": false,
      "message": "Field 'name' is required",
      "data": null,
      "trace_id": "hv-1234567890abcdef",
      "error_code": "VALIDATION_ERROR"
    }
  },
  "response_headers": {
    "X-Request-Id": {
      "type": "string",
      "description": "Same value as trace_id in the body. Present in every response.",
      "pattern": "^hv-[a-f0-9]{16}$"
    }
  },
  "request_headers": {
    "X-API-Key": {
      "type": "string",
      "description": "API key for authenticating the client",
      "required": true
    },
    "Authorization": {
      "type": "string",
      "description": "Bearer JWT token for authenticated endpoints",
      "pattern": "^Bearer .+$",
      "required": "for authenticated endpoints"
    },
    "X-Trace-Parent": {
      "type": "string",
      "description": "Optional parent trace_id from upstream caller for trace lineage",
      "pattern": "^hv-[a-f0-9]{16}$",
      "required": false
    }
  },
  "error_code_registry": [
    "AUTH_INVALID_TOKEN",
    "AUTH_EXPIRED_TOKEN",
    "AUTH_MISSING_KEY",
    "VALIDATION_ERROR",
    "RESOURCE_NOT_FOUND",
    "RESOURCE_CONFLICT",
    "RATE_LIMITED",
    "INTERNAL_ERROR",
    "SERVICE_UNAVAILABLE",
    "CSRF_INVALID",
    "PERMISSION_DENIED"
  ],
  "deterministic_fields": ["trace_id", "error_code", "success"],
  "replay_safe": true,
  "ecosystem_participant": "hackaverse-api-v1"
}
